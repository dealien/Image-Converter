{
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/python": {
      "version": "3.13.7"
    }
  },
  "postCreateCommand": "pip3 install --user -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "meta.pyrefly",
        "pflannery.vscode-versionlens",
        "fill-labs.dependi"
      ]
    }
  }
}