{
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/python": {
      "version": "3.13.7"
    },
    "ghcr.io/itsalljustdata/devcontainers-custom-features/python-virtualenv:1": {
        "requirementsFile": "${containerWorkspaceFolder}/pyproject.toml"
    }
  },
  "postCreateCommand": "pip install -e '.[dev,docs]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "meta.pyrefly",
        "pflannery.vscode-versionlens",
        "fill-labs.dependi",
        "SharashchandraDesai.simple-scratch",
        "ldez.ignore-files"
      ]
    }
  }
}