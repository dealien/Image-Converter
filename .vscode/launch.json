    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Image Converter (Module)",
            "type": "debugpy",
            "request": "launch",
            "module": "image_converter",
            "console": "integratedTerminal",
            "args": [
                "--menu"
            ],
            "preLaunchTask": "copyTestImages"
        },
        {
            "name": "Python: Automated Testing",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/automated_testing.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Verify UI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/verify_ui.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [],
            "console": "integratedTerminal"
        }
    ]
}